# Nach Implementierung in .env kopieren; Docker Compose liest dieses File.
MONITOR_INTERVAL_SECONDS=3600
MONITOR_DB_PATH=/data/appointments.sqlite3
MONITOR_HEADLESS=true
MONITOR_LOG_LEVEL=INFO
MONITOR_REQUEST_DELAY_SECONDS=1.5
MONITOR_TELEGRAM_ENABLED=false

# Erst in einer späteren Version eventuell nötig; momentan NICHT aktivieren:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
