# Nach Implementierung in .env kopieren; Docker Compose liest dieses File.
MONITOR_INTERVAL_SECONDS=3600
MONITOR_DB_PATH=/data/appointments.sqlite3
MONITOR_HEADLESS=true
MONITOR_LOG_LEVEL=INFO
MONITOR_REQUEST_DELAY_SECONDS=1.5
MONITOR_FEDERAL_STATE=sachsen-anhalt
MONITOR_TELEGRAM_ENABLED=false
MONITOR_TELEGRAM_COMMANDS_ENABLED=true
MONITOR_TELEGRAM_COMMAND_POLL_SECONDS=5
# Optional startup-only Bot-Token-Prüfung via Telegram getMe; keine Nachricht wird gesendet.
TELEGRAM_BOT_TOKEN=
# Zielchat für Benachrichtigungen über neue oder erhöhte freie Plätze.
# Keine Bot-ID verwenden: Der Bot kann sich selbst keine Nachrichten senden.
TELEGRAM_CHAT_ID=
